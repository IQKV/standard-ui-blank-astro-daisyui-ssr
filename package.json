{
  "name": "@iqkv/standard-ui-blank-astro-daisyui-ssr",
  "version": "0.0.0",
  "description": "A minimal Astro boilerplate with Tailwind, DaisyUI, React islands",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "astro check",
    "dev": "astro dev",
    "formatter:check": "oxfmt --check",
    "formatter:write": "oxfmt --write",
    "lint": "pnpm lint:eslint",
    "lint:eslint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro",
    "lint:eslint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.astro --fix",
    "node_modules:cleanup": "rm -rf node_modules",
    "prepare": "husky",
    "preview": "astro preview",
    "release": "release-it --ci",
    "start": "node dist/server/entry.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "oxlint --type-aware",
      "oxfmt --write"
    ],
    "*.{css,json,md}": [
      "oxfmt --write"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@astrojs/tailwind": "^6.0.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "2.16.2",
    "astro": "^7.3.5",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.47",
    "framer-motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.0",
    "sanitize-html": "2.18.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "husky": "9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier-plugin-astro": "^1.1.0",
    "release-it": "^21.1.0",
    "release-it-pnpm": "^4.6.6",
    "sort-package-json": "^4.0.0",
    "tsdown": "^0.23.0",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.13.0"
  }
}

{
  "name": "@iqkv/standard-ui-blank-astro-daisyui-ssr",
  "version": "0.0.0",
  "description": "A minimal Astro boilerplate with Tailwind, DaisyUI, React islands",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "astro check",
    "dev": "astro dev",
    "formatter:check": "oxfmt --check",
    "formatter:write": "oxfmt --write",
    "lint": "pnpm lint:eslint",
    "lint:eslint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro",
    "lint:eslint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.astro --fix",
    "node_modules:cleanup": "rm -rf node_modules",
    "prepare": "husky",
    "preview": "astro preview",
    "release": "release-it --ci",
    "start": "node dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.0",
    "@astrojs/react": "^6.0.2",
    "@astrojs/tailwind": "^6.0.2",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "2.16.1",
    "astro": "^7.2.0",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.4",
    "framer-motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.20.0",
    "sanitize-html": "2.17.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "glob": "^13.0.6",
    "globals": "^17.11.0",
    "husky": "9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier-plugin-astro": "^0.14.1",
    "release-it": "^21.0.2",
    "release-it-pnpm": "^4.6.6",
    "sort-package-json": "^4.0.0",
    "tsdown": "^0.22.14",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "oxlint --type-aware",
      "oxfmt --write"
    ],
    "*.{css,json,md}": [
      "oxfmt --write"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.2"
}
